---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getOrderedDocs } from "../../lib/docs";
import Py from "../../components/Py.astro";
import Ts from "../../components/Ts.astro";
import Sw from "../../components/Sw.astro";
import Callout from "../../components/Callout.astro";

export async function getStaticPaths() {
  const docs = await getOrderedDocs();
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<DocsLayout entry={entry}>
  <Content components={{ Py, Ts, Sw, Callout }} />
</DocsLayout>
